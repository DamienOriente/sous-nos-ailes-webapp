# ──────────────────────────────────────────────────────────────────────────────
# Sous Nos Ailes — environment variables
# Copy to .env for local development (pnpm dev). Docker Compose sets its own
# values. NEVER commit a .env with real values. All values below are placeholders
# or local-only defaults; none of them is a valid production secret.
# ──────────────────────────────────────────────────────────────────────────────

# local | test | production. Production refuses DEMO_MODE=true and requires
# every *_SECRET to be set explicitly.
APP_ENV=local
# Enables demo accounts, the demo banner and fictitious professionals (local only).
DEMO_MODE=true
# Public indexing (robots, sitemap) stays off until the go-live checklist passes.
INDEXING_ENABLED=false
# Public URL of the app: canonical links, e-mails, OAuth callbacks, Stripe redirects.
APP_URL=http://localhost:3200
# Default timezone for display when the user has none configured.
DEFAULT_TIMEZONE=Europe/Paris

# PostgreSQL (docker compose up db → host port 5450).
DATABASE_URL=postgresql://sna:sna@localhost:5450/sna
# Max connections of the application pool (keep below PostgreSQL max_connections / replicas).
DATABASE_POOL_MAX=10

# Redis — queues (BullMQ), rate limiting, short-lived caches.
REDIS_URL=redis://localhost:6390

# Sessions / auth (better-auth). Generate with: openssl rand -base64 32
# In local mode, when absent, a key is generated into .secrets/auth.key (gitignored).
# BETTER_AUTH_SECRET=
# Encryption key for sensitive columns (child health notes, OAuth refresh tokens).
# 32 bytes base64. Generate with: openssl rand -base64 32
# DATA_ENCRYPTION_KEY=

# Transactional e-mail — any SMTP provider (Brevo SMTP relay, Mailpit locally).
SMTP_HOST=localhost
SMTP_PORT=1027
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="Sous Nos Ailes <no-reply@sousnosailes.test>"

# Object storage — S3 compatible (MinIO locally, Scaleway/OVH in production).
S3_ENDPOINT=http://localhost:9010
S3_REGION=fr-par
S3_BUCKET=sna-files
S3_QUARANTINE_BUCKET=sna-quarantine
S3_ACCESS_KEY=sna-minio
S3_SECRET_KEY=sna-minio-local-only
S3_FORCE_PATH_STYLE=true

# Antivirus — ClamAV daemon (clamd). Set CLAMAV_ENABLED=false only in local dev.
CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Stripe Billing (TEST MODE ONLY until the commercial go-live is validated).
# Keys come from https://dashboard.stripe.com/test/apikeys. Webhook secret from
# `stripe listen` or the dashboard endpoint. When unset, billing runs in "mock"
# mode: checkout is simulated locally and clearly labelled as such.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google Calendar (OAuth 2.0). Create credentials at console.cloud.google.com,
# authorised redirect: ${APP_URL}/api/integrations/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft Graph (OAuth 2.0). Register an app at entra.microsoft.com,
# redirect: ${APP_URL}/api/integrations/microsoft/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# Observability
LOG_LEVEL=info

# Force production-grade auth rate limits locally (5 sign-ups/min, 10 sign-ins/min per IP) to test the 429 path.
AUTH_RATE_LIMIT_STRICT=false
