    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/cormorant": "5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@hookform/resolvers": "5.9.1",
    "better-auth": "1.7.10",
    "bullmq": "6.3.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "file-type": "22.2.0",
    "ioredis": "6.0.0",
    "lucide-react": "1.57.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "node-ical": "0.27.3",
    "nodemailer": "10.1.2",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
