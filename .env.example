# Copy to .env for local development outside Docker (pnpm dev).
# Docker Compose sets its own values in docker-compose.yml.

# local | production. Production refuses DEMO_MODE=true.
APP_ENV=local
# Demo accounts, demo banner, fictitious venues. Local only.
DEMO_MODE=true
# Public indexing stays off until the production checklist is validated.
INDEXING_ENABLED=false
# Public URL of the app (used for emails, canonicals, sitemap).
APP_URL=http://localhost:3100

# PostgreSQL started by `docker compose up db` (host port 5440).
DATABASE_URL=postgresql://lpi:lpi@localhost:5440/lpi

# Mailpit started by `docker compose up mailpit` (SMTP host port 1026, UI on http://localhost:8026).
SMTP_HOST=localhost
SMTP_PORT=1026
MAIL_FROM="Les Petits Invités <no-reply@example.test>"

# Optional. When absent in local mode, a random key is generated into .secrets/session.key (chmod 600).
# SESSION_SECRET=
